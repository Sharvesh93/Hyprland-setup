# Disable fish greeting
set -g fish_greeting

# Source Matugen generated colors and syntax highlighting
if test -f ~/.config/matugen/generated/colors.fish
    source ~/.config/matugen/generated/colors.fish
end

# Aliases
alias ls="eza -la --icons --color=always"
alias ll="ls -lh"
alias la="ls -A"
alias gs="git status"
#alias ls="eza -la --icons --color=always"
# History settings
set -g fish_history_max_items 50000

# Integrations
if command -sq zoxide
    zoxide init fish | source
end

if command -sq fzf
    fzf --fish | source
end


# ------------  VARIABLES ------------------
set -Ux EDITOR nvim
set -Ux VISUAL nvim 
fastfetch
